[resource]
script = ExtResource("1_data")
id = "escamaduras"
display_name = "Escamaduras"
singular = "Escamadura"
epithet = "El depredador alfa"
lore = "Menos voluminosos que un Tiemblatierras, pero con una musculatura tan compacta que son aún más fuertes de lo que aparentan.

Todo su cuerpo es un arma: manos de cinco dedos con uñas alargadas, mandíbula de cazador y un cráneo protegido por hueso, con una [b]cresta sutil[/b] encima. Otra cresta, robusta, les recorre la espalda hasta la nuca.

Rápidos y letales, se mueven ligeramente inclinados hacia delante, sin perder nunca de vista a su presa."
height_text = "1,9 – 2,1 m"
strength = "Velocidad y mucho daño"
height_m = 2.0
