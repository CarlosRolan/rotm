[resource]
script = ExtResource("1_data")
id = "tiemblatierras"
display_name = "Tiemblatierras"
singular = "Tiemblatierras"
epithet = "Los más grandes de los Kaurkas"
lore = "Moles de hueso ancho y piel gruesa, cubiertas por las escamas más duras de su pueblo y por placas óseas que, en su máxima expresión, crecen hasta formar una [b]corona de hueso[/b].

Caminan sobre piernas como pilares y pies de elefante, con el peso siempre abajo y la cabeza hundida entre los hombros. Su temperamento es tan calmado como pesado su paso.

Son la única subraza [b]omnívora[/b]: sus dientes, pequeños y separados como los de un pato, asoman apenas por los lados de la boca."
height_text = "2,0 – 2,3 m"
strength = "Fuerza y resistencia"
height_m = 2.15
mesh_name = "mesh_tiemblatierra"
fallback_model = "res://imported_models/Crystal_Sentinel/Crystal_Sentinel.glb"
background = ExtResource("2_bg")
accent = Color(0.86, 0.58, 0.28, 1)
